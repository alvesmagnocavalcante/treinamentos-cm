# Copie para .env sem sobrescrever credenciais existentes.
GOOGLE_API_KEY=
DATABASE_URL=
# Obrigatória: a aplicação utiliza somente PostgreSQL com pgvector.
# Aiven: postgres://USUARIO:SENHA@HOST:PORTA/BANCO?sslmode=require
# Opcional: certificado CA para verificar identidade do servidor (ativa verify-full).
DATABASE_SSL_ROOT_CERT=
# Drive privado: habilite a Google Drive API e compartilhe a pasta com a conta de serviço.
# Caminho absoluto para o JSON de credenciais; mantenha-o fora do Git.
# GOOGLE_APPLICATION_CREDENTIALS=/caminho/seguro/google-drive.json
# Alternativa na hospedagem: JSON completo como variável protegida.
# GOOGLE_SERVICE_ACCOUNT_JSON=
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# No contêiner, para domínio próprio: https://treinamentos.exemplo.com
# O hostname padrão do Render é configurado automaticamente.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Em desenvolvimento, vazio gera chave local persistente em .cache/django-secret.
# Em produção, defina uma chave secreta exclusiva e DJANGO_DEBUG=false.
DJANGO_SECRET_KEY=
HTTP_TIMEOUT_SECONDS=60
MAX_UPLOAD_MB=10
CHUNK_TOKENS=1000
CHUNK_OVERLAP_TOKENS=150
RAG_MAX_DISTANCE=0.5

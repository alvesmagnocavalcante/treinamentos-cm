# Copie para .env sem sobrescrever credenciais existentes.
GOOGLE_API_KEY=
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

DJANGO_DATABASE_PATH=app/database/platform.sqlite3
LEGACY_DATABASE_PATH=app/database/training.sqlite3
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Em desenvolvimento, vazio gera chave local persistente em .cache/django-secret.
# Em produção, defina uma chave secreta exclusiva e DJANGO_DEBUG=false.
DJANGO_SECRET_KEY=

DOCUMENTS_PATH=media/documentos
VECTOR_DB_PATH=vector_db
HTTP_TIMEOUT_SECONDS=60
MAX_UPLOAD_MB=10
CHUNK_TOKENS=1000
CHUNK_OVERLAP_TOKENS=150
RAG_MAX_DISTANCE=0.5
